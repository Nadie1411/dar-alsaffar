APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: order confirmations, delivery updates and password resets. "log" writes
# them to storage/logs instead of sending, which is right for development. In
# production use "smtp" with your mail provider's details, and a from-address on
# your own domain.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OVERZAKI_BASE_URL=https://production.overzaki.org/api
OVERZAKI_TENANT_ID=dar-alsaffar.net
OVERZAKI_CURRENCY_ID=
OVERZAKI_COUNTRY_ID=

# Store control panel — set with: php artisan store:password
# With no hash configured, /admin returns 404.
ADMIN_PASSWORD_HASH=

# Where the storefront gets its shop from: "overzaki" (the original setup, the
# default) or "local" (this application's own database). Flip it back to
# "overzaki" to roll the switch-over back.
STORE_BACKEND=overzaki

# Online payments through MyFatoorah. The API key is a SECRET: set it only in the
# server's .env (or let an owner paste it in the admin panel, Payments > Manage
# payment keys), never commit it. With no key anywhere "pay online" is not offered.
# The live Kuwait address is below; the sandbox (no real money) is
# https://apitest.myfatoorah.com. Other countries: see config/myfatoorah.php.
MYFATOORAH_API_KEY=
MYFATOORAH_API_URL=https://api.myfatoorah.com
# The secret key from the MyFatoorah portal: Integration Settings > Webhook Settings.
MYFATOORAH_WEBHOOK_SECRET=
# Only if MyFatoorah must be given a different public https host than the site's own
# (for example a tunnel while testing against the sandbox). No trailing slash.
MYFATOORAH_CALLBACK_URL=
# Set to false to switch online payment off without removing the key.
MYFATOORAH_ENABLED=true

